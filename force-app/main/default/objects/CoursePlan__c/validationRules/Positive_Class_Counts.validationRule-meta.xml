<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Positive_Class_Counts</fullName>
    <active>true</active>
    <errorConditionFormula>OR(Classes_Per_Week__c &lt; 1, Class_Duration_Minutes__c &lt; 1)</errorConditionFormula>
    <errorMessage>Classes per week and duration per class must both be at least 1.</errorMessage>
</ValidationRule>
