<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description>Sets UniqueKey__c to CourseId_StudentId after an Enrollment record is inserted.</description>
    <label>Enrollment Set UniqueKey</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_UniqueKey</targetReference>
        </connector>
        <object>Enrollment__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <formulas>
        <name>UniqueKeyFormula</name>
        <dataType>String</dataType>
        <expression>{!$Record.Course__c} &amp; "_" &amp; {!$Record.Student__c}</expression>
    </formulas>
    <recordUpdates>
        <name>Update_UniqueKey</name>
        <label>Update UniqueKey</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>UniqueKey__c</field>
            <value>
                <elementReference>UniqueKeyFormula</elementReference>
            </value>
        </inputAssignments>
        <object>Enrollment__c</object>
    </recordUpdates>
</Flow>
