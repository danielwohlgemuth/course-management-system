    <description>Allows a student to browse available courses and self-enroll in one or more. Runs in system context so all courses are visible regardless of the running user&apos;s sharing access. Only shows courses the student is not already enrolled in.</description>
    <environments>Default</environments>
    <label>Join a Course</label>
    <loops>
        <name>Loop_Build_Course_Ids</name>
        <label>Build Enrolled Course ID List</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_My_Enrollments</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Add_Course_Id</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_All_Courses</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Create_Enrollments</name>
        <label>Build Enrollment Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>selectedCourses</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_New_Enrollment</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_Enrollments</targetReference>
        </noMoreValuesConnector>
    </loops>
