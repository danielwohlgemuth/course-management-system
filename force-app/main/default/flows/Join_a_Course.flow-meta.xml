<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Available_Course</name>
        <label>Add to Available Courses</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>availableCourses</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Filter_Available_Courses</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Filter_Available_Courses</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Current_Course_Id</name>
        <label>Store Current Course ID</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>currentCourseId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Filter_Available_Courses.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assign_Reset_IsEnrolled</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Reset_IsEnrolled</name>
        <label>Reset Enrolled Flag</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>isEnrolledInCourse</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Check_Enrollment</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Set_IsEnrolled</name>
        <label>Set Enrolled Flag</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>isEnrolledInCourse</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Check_Enrollment</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Decision_Add_Course</name>
        <label>Add Course to Available?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Available_Course</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Enrolled</defaultConnectorLabel>
        <rules>
            <name>Rule_Skip_Enrolled_Course</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isEnrolledInCourse</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Filter_Available_Courses</targetReference>
            </connector>
            <label>Already Enrolled</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Enrollment_Matches</name>
        <label>Enrollment Matches This Course?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Check_Enrollment</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Match</defaultConnectorLabel>
        <rules>
            <name>Rule_Match_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Check_Enrollment.Course__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>currentCourseId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Set_IsEnrolled</targetReference>
            </connector>
            <label>Match</label>
        </rules>
    </decisions>
    <description>Allows a student to browse available courses and self-enroll in one or more. Runs in system context so all courses are visible regardless of the running user&apos;s sharing access. Only shows courses the student is not already enrolled in.</description>
    <environments>Default</environments>
    <label>Join a Course</label>
    <loops>
        <name>Loop_Check_Enrollment</name>
        <label>Check Each Enrollment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>myEnrollments</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Decision_Enrollment_Matches</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Decision_Add_Course</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Create_Enrollments</name>
        <label>Create Enrollments for Selected Courses</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>selectedCourses</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Create_Enrollment</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Screen_Success</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Filter_Available_Courses</name>
        <label>Filter Available Courses</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>allCourses</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Current_Course_Id</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Screen_Select_Course</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
